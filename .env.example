# Base Environment Configuration
# Automatically switches endpoints: localhost = development, remote domain = production.

# Local Development Endpoints
VITE_DEV_APP_URL="http://localhost:5173"
VITE_DEV_API_URL="http://localhost:3000/v1/api"

# Production Endpoints (Vercel / Railway / Render)
VITE_PROD_APP_URL="https://spillrate.up.railway.app"
VITE_PROD_API_URL="https://spillrate-api.up.railway.app/v1/api"

# Legacy Fallback
VITE_API_BASE_URL="http://localhost:3000/v1/api"
VITE_APP_URL="http://localhost:5173"

# Set to "true" if you want your localhost SPA to interact with the production API
VITE_USE_PROD_API="false"
